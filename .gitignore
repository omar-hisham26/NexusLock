# ========================================================
# .gitignore for NexusLock (Python + Windows + PyInstaller)
# ========================================================

# Compiled binaries, executables, and Setup wizard installers
*.exe
*.msi
*.dll
*.so
*.dylib
Output/

# PyInstaller build artifacts & cache
build/
dist/
*.spec

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyc

# User local data & settings (personal machine paths)
data/settings.json
settings.json
*.log
error.log

# Operating System files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# Editor / IDE settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.gemini/

# Virtual environments
venv/
env/
.env
ENV/
