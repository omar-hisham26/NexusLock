# ========================================================
# .gitignore for NetherWatch (Python + Windows + PyInstaller)
# ========================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyc

# PyInstaller build artifacts & cache
build/
*.spec

# User local data & settings (personal machine paths)
data/settings.json
settings.json
*.log
error.log

# Operating System files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# Editor / IDE settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.gemini/

# Virtual environments
venv/
env/
.env
ENV/
